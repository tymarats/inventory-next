root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.{cs,csx}]
indent_style = space
indent_size = 4

# EF Core's migration generator ignores this, so migrations stay block-scoped and the code carried
# over from the original was left as it is rather than split into two styles.
csharp_style_namespace_declarations = file_scoped
